OTASIGN_IMAGE_TAG=latest
OTASIGN_FRONTEND_URL=https://otaportal.operatortraining.academy

KEYCLOAK_ISSUER_URL=https://keycloak.operatortraining.academy/realms/ota
KEYCLOAK_CLIENT_ID=ota-sign
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret
KEYCLOAK_REDIRECT_URL=https://otaportal.operatortraining.academy/auth/keycloak/callback
KEYCLOAK_DOD_ID_CLAIM=dod_id
KEYCLOAK_UIC_CLAIM=uic
KEYCLOAK_RANK_CLAIM=rank
KEYCLOAK_ARMY_EMAIL_CLAIM=army_email

DATABASE_URL=postgres://otasign:replace-me@postgres:5432/otasign?sslmode=disable

DOCUSEAL_URL=http://docuseal:3000
DOCUSEAL_PUBLIC_URL=https://sign.operatortraining.academy
DOCUSEAL_API_KEY=replace-with-docuseal-api-key
DOCUSEAL_WEBHOOK_SECRET=replace-with-docuseal-webhook-secret

NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
